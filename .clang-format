Language: Cpp
BasedOnStyle: Microsoft
IndentWidth: 4
ColumnLimit: 120
PointerAlignment: Left
ReferenceAlignment: Left
NamespaceIndentation: All
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"pch.h"$'
    Priority: 0
  - Regex: '^"ModulePreamble.h"$'
    Priority: 1
  - Regex: '^".*"$'
    Priority: 2
  - Regex: '^<.*\.h>$' # Third-party library headers
    Priority: 3
  - Regex: '^<.*>$'    # STL headers
    Priority: 4
QualifierAlignment: Left
