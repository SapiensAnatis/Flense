<Project>

  <!--
    Custom wiring around Microsoft.Cpp.ClangTidy.targets to get clang-tidy to analyze C++ modules.
	We pre-build the clang .pcms using the module dependency graph that MSBuild has already worked
	out for us, and pass them as AdditionalOptions to clang-tidy.
  -->
  <PropertyGroup>
    <ClangTidyDependsOn>$(ClangTidyDependsOn);BuildClangTidyModuleBmis</ClangTidyDependsOn>
  </PropertyGroup>

  <Target Name="BuildClangTidyModuleBmis"
          Condition="'$(RunClangCppAnalysis)' == 'true' and '$(EnableCppModules)' == 'true'">

    <PropertyGroup>
      <ClangTidyBmiIntDir>$(IntDir)ClangTidyModules\</ClangTidyBmiIntDir>
      <ClangTidyBmiTLogDir>$(TLogLocation)ClangTidyModules\</ClangTidyBmiTLogDir>
      <!-- Silence Clang output and let clang-tidy report any errors -->
      <ClangTidyBmiQuietOptions>/w -Wno-unknown-argument -Wno-unused-command-line-argument</ClangTidyBmiQuietOptions>
    </PropertyGroup>

    <!-- 
	  Naming each .pcm after its .ifc means this same rewrite, applied to a dependency list,
      always resolves to the file the .pcm build below actually wrote. 
	-->
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.CompilerIteration)' == 'Modules'">
        <ClangTidyBmiFile>$([MSBuild]::ValueOrDefault('%(ClCompile.ModuleOutputFile)', '').Replace('.ifc', '.pcm'))</ClangTidyBmiFile>
      </ClCompile>
      <ClCompile Condition="'%(ClCompile.AdditionalModuleDependencies)' != ''">
        <ClangTidyModuleFiles>-fmodule-file=$([MSBuild]::ValueOrDefault('%(ClCompile.AdditionalModuleDependencies)', '').TrimEnd(';').Replace('.ifc', '.pcm').Replace(';', ' -fmodule-file='))</ClangTidyModuleFiles>
      </ClCompile>
    </ItemGroup>

    <ItemGroup>
      <_ClangTidyBmi Include="@(ClCompile)"
                     Condition="'%(ClCompile.CompilerIteration)' == 'Modules' and '%(ClCompile.ExcludedFromBuild)' != 'true'">
        <AdditionalOptions>%(ClCompile.AdditionalOptions) $(ClangTidyAdditionalOptions) $(ClangTidyBmiQuietOptions) -x c++-module /c -fmodule-output=%(ClCompile.ClangTidyBmiFile) %(ClCompile.ClangTidyModuleFiles)</AdditionalOptions>
        <ObjectFileName>$(ClangTidyBmiIntDir)%(ClCompile.Filename)%(ClCompile.Extension).obj</ObjectFileName>
        <TrackerLogDirectory>$(ClangTidyBmiTLogDir)</TrackerLogDirectory>

        <!-- MSVC uses different flag names for module options -->
        <ModuleOutputFile />
        <AdditionalModuleDependencies />
        <AdditionalHeaderUnitDependencies />
        <AdditionalBMIDirectories />
        <GenerateModuleDependencies />
        <ModuleDependenciesFile />
        <BuildStlModules />
        <CompileAs />
        <EnableClServerMode />

        <!-- Remove arguments that don't apply to clang -->
        <PrecompiledHeader />
        <PrecompiledHeaderFile />
        <PrecompiledHeaderOutputFile />
        <BrowseInformation />
        <BrowseInformationFile />
        <CompileAsManaged />
        <CompileAsWinRT />
        <DebugInformationFormat />
        <DisableLanguageExtensions />
        <DisableSpecificWarnings />
        <EnableFiberSafeOptimizations />
        <MultiProcessorCompilation />
        <EnableParallelCodeGeneration />
        <EnablePREfast />
        <EnforceTypeConversionRules />
        <ErrorReporting />
        <ExpandAttributedSource />
        <ForceConformanceInForLoopScope />
        <ForcedUsingFiles />
        <GenerateXMLDocumentationFiles />
        <IgnoreStandardIncludePath />
        <MinimalRebuild />
        <OpenMPSupport />
        <PREfastAdditionalOptions />
        <PREfastAdditionalPlugins />
        <PREfastLog />
        <PREfastProjectDirectory />
        <PREfastRulesetDirectories />
        <PREfastRulesetFile />
        <ProgramDataBaseFileName />
        <RemoveUnreferencedCodeData />
        <SDLCheck />
        <SpectreMitigation />
        <StringPooling />
        <SupportJustMyCode />
        <TreatSpecificWarningsAsErrors />
        <TreatWChar_tAsBuiltInType />
        <UseFullPaths />
        <WholeProgramOptimization />
      </_ClangTidyBmi>
    </ItemGroup>

    <MakeDir Directories="$(ClangTidyBmiIntDir);$(ClangTidyBmiTLogDir)" />

	<!-- 
	  MultiToolTask lets us take the existing MultiToolTaskDependency metadata attached to ClCompile, 
	  and gives us correctly-ordered, incremental, and parallel module compilation for free.
	-->
    <MultiToolTask
      Condition                  ="'@(_ClangTidyBmi)' != ''"
      TaskName                   ="Microsoft.Build.CPPTasks.CL"
      Sources                    ="@(_ClangTidyBmi)"

      TrackerLogDirectory        ="$(ClangTidyBmiTLogDir)"
      MinimalRebuildFromTracking ="true"
      ToolArchitecture           ="$(CLToolArchitecture)"
      TrackerFrameworkPath       ="$(CLTrackerFrameworkPath)"
      TrackerSdkPath             ="$(CLTrackerSdkPath)"
      ToolExe                    ="clang-cl.exe"
      ToolPath                   ="$(ClangTidyToolPath)"
      TrackFileAccess            ="$(TrackFileAccess)"
      MaxProcessCount            ="$(MultiProcMaxCount)"
      SchedulerName              ="$(MultiProcSchedulerName)" />

    <!-- Remove STL / external modules from ClCompile temporarily so clang-tidy doesn't run on them -->
    <ItemGroup>
      <_ClangTidyForeignModule Include="@(ClCompile)"
                               Condition="'%(ClCompile.CompilerIteration)' == 'Modules' and !$([MSBuild]::ValueOrDefault('%(ClCompile.FullPath)', '').StartsWith('$(MSBuildProjectDirectory)'))" />
      <ClCompile Remove="@(_ClangTidyForeignModule)" />
    </ItemGroup>

    <!-- 
	  GetCompileCommands takes only items with an empty CompilerIteration, fudge this so that we correctly 
	  pass .ixx modules to clang-tidy for linting. Make sure to restore afterwards.
	-->
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.CompilerIteration)' == 'Modules'">
        <CompilerIteration />
        <ClangTidyCompileAs>%(ClCompile.CompileAs)</ClangTidyCompileAs>
        <CompileAs />
        <AdditionalOptions>%(ClCompile.AdditionalOptions) -x c++-module</AdditionalOptions>
      </ClCompile>
      <ClCompile Condition="'%(ClCompile.ClangTidyModuleFiles)' != ''">
        <AdditionalOptions>%(ClCompile.AdditionalOptions) %(ClCompile.ClangTidyModuleFiles)</AdditionalOptions>
      </ClCompile>
    </ItemGroup>

  </Target>

  <!-- Re-add the ClCompile items we removed earlier, and fix the metadata of modified ClCompile items -->
  <Target Name="RestoreClangTidyModuleMetadata" AfterTargets="ClangTidy"
          Condition="'$(RunClangCppAnalysis)' == 'true' and '$(EnableCppModules)' == 'true'">
    <ItemGroup>
      <ClCompile Include="@(_ClangTidyForeignModule)" />
      <_ClangTidyForeignModule Remove="@(_ClangTidyForeignModule)" />
      <ClCompile Condition="'%(ClCompile.ClangTidyCompileAs)' != ''">
        <CompileAs>%(ClCompile.ClangTidyCompileAs)</CompileAs>
        <CompilerIteration>Modules</CompilerIteration>
      </ClCompile>
    </ItemGroup>
  </Target>

</Project>
