  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!--
    VC projects don't support wildcards in project items, so the archives generated by TestData/GenerateErrorCases.ps1
    are handed to the built-in CopyFileToFolders step at build time instead. That also keeps them out of Solution
    Explorer, while CopyFileToFolders still tracks them for the IDE's up-to-date check.
  -->
  <PropertyGroup>
    <PrepareForBuildDependsOn>AddTestDataToCopy;$(PrepareForBuildDependsOn)</PrepareForBuildDependsOn>
  </PropertyGroup>
  <Target Name="AddTestDataToCopy">
    <ItemGroup>
      <CopyFileToFolders Include="$(MSBuildProjectDirectory)\..\TestData\ErrorCases\*.tar">
        <DestinationFolders>$(OutDir)TestData\ErrorCases</DestinationFolders>
      </CopyFileToFolders>
    </ItemGroup>
  </Target>
</Project>
