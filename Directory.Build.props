<Project>
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
  </PropertyGroup>
  <!--
      Keeps NuGet restore output (project.assets.json, nuget.g.props/targets) outside the repo tree when set.
      This repo is shared between the host and a container checkout under different accounts/NuGet caches;
      whichever side restores last clobbers the other's cached paths, defeating incremental builds for both.
      Per-project (via $(MSBuildProjectName)) so Flense and Flense.Core don't collide. Set by build-app.ps1.
  -->
  <PropertyGroup Condition="'$(FlenseIntermediateOutputRoot)' != ''">
    <BaseIntermediateOutputPath>$(FlenseIntermediateOutputRoot)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp23</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
