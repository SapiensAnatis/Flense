<Project>
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp23</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Set FlenseBaseOutputPath to avoid container builds and VS builds overwriting each other -->
  <PropertyGroup Condition="'$(FlenseBaseOutputPath)' != ''">
    <BaseIntermediateOutputPath>$(FlenseBaseOutputPath)\out\$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <BaseOutputPath>$(FlenseBaseOutputPath)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
