ExtraArgsBefore: ['/std:c++23preview']
# For some reason, .ixx are treated as headers and analysed multiple times - better to analyse them as implementation files
ExcludeHeaderFilterRegex: '\.ixx$|Generated Files'
ImplementationFileExtensions: ['cpp', 'ixx']
CheckOptions:
  readability-identifier-naming.LocalVariableCase: "camelBack"
  readability-identifier-naming.FunctionCase: "CamelCase"
  readability-identifier-naming.ConstexprVariableCase: "CamelCase"
  readability-identifier-naming.StructCase: "CamelCase"
  readability-identifier-naming.EnumCase: "CamelCase"
  readability-identifier-naming.MacroDefinitionCase: "UPPER_CASE"
  misc-include-cleaner.IgnoreHeaders: ".*nlohmann.*;pch.h"
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
WarningsAsErrors: '*'
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  concurrency-*,
  misc-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,