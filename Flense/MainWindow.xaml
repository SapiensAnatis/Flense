<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Flense.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Flense"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!--  Title Bar  -->
            <RowDefinition Height="Auto" />
            <!--  App Content  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind TitleBarService.Title, Mode=OneWay}"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  App content  -->
        <Frame
            x:Name="rootFrame"
            Grid.Row="1"
            Navigated="RootFrame_Navigated"
            SourcePageType="local:LandingPage" />
    </Grid>
</Window>
