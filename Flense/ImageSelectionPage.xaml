<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ImageTemplate" x:DataType="local:DockerEngineImage">
            <TextBlock Text="{x:Bind RepoTag}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <StackPanel
            x:Name="LoadingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <ProgressRing Width="48" Height="48" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyLargeTextBlockStyle}"
                Text="Loading images from Docker" />
            <Button
                x:Name="CancelLoadingButton"
                MinWidth="100"
                HorizontalAlignment="Center"
                Click="CancelLoadingButton_Click"
                Content="Cancel" />
        </StackPanel>

        <ListView
            x:Name="ImageList"
            ItemTemplate="{StaticResource ImageTemplate}"
            ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}" />
    </Grid>
</Page>
