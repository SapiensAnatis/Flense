<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <local:FileSizeStringConverter x:Key="FileSizeStringConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,8" HorizontalAlignment="Stretch">
        <StackPanel
            x:Name="LoadingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing Width="48" Height="48" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyLargeTextBlockStyle}"
                Text="Loading images from Docker" />
            <Button
                x:Name="CancelLoadingButton"
                MinWidth="100"
                HorizontalAlignment="Center"
                Click="CancelLoadingButton_Click"
                Content="Cancel" />
        </StackPanel>

        <StackPanel
            x:Name="LoadFailurePanel"
            MaxWidth="600"
            VerticalAlignment="Center"
            x:Load="{x:Bind ViewModel.HasFailed, Mode=OneWay}"
            Spacing="20">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Couldn't load images"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="LoadFailureBackButton"
                MinWidth="100"
                HorizontalAlignment="Center"
                Click="CancelButton_Click"
                Content="Go back"
                Loaded="LoadFailureBackButton_Loaded" />
        </StackPanel>

        <Grid
            x:Name="ImageListGrid"
            MaxWidth="1400"
            Padding="24"
            x:Load="{x:Bind local:BindingHelpers.AndNot(ViewModel.HasLoaded, ViewModel.IsLoading), Mode=OneWay}"
            RowSpacing="16">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource TitleTextBlockStyle}">
                Available images
            </TextBlock>
            <TextBox
                x:Name="ImageSearchBox"
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                PlaceholderText="Search"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsView
                x:Name="ImageList"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                IsItemInvokedEnabled="True"
                ItemInvoked="ImageList_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                SelectionChanged="ImageList_SelectionChanged"
                SelectionMode="Single">
                <ItemsView.Layout>
                    <StackLayout Spacing="4" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="local:DockerEngineImage">
                        <ItemContainer AutomationProperties.Name="{x:Bind RepoTag}">
                            <Grid
                                MinHeight="44"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="12"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind RepoTag}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{x:Bind local:Formatting.FormatDate(Created)}" />
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                    <Run Text="Created" />
                                    <Run Text="{x:Bind local:Formatting.FormatRelativeTime(Created)}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Size, Converter={StaticResource FileSizeStringConverter}}" />
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="OpenImageButton"
                    HorizontalAlignment="Right"
                    Click="OpenImageButton_Click"
                    IsEnabled="False"
                    Loaded="OpenImageButton_Loaded"
                    Style="{StaticResource AccentButtonStyle}">
                    Open image
                </Button>
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Right"
                    Click="CancelButton_Click">
                    Cancel
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
