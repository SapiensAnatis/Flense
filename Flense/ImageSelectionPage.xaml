<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ImageTemplate" x:DataType="local:DockerEngineImage">
            <TextBlock Text="{x:Bind RepoTag}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ListView ItemTemplate="{StaticResource ImageTemplate}" ItemsSource="{x:Bind ViewModel.Images}" />
    </Grid>
</Page>
