<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flense.LandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flense"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="16" RowSpacing="8" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="600" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="24">
            <TextBlock 
                TextAlignment="Center"
                Text="Flense" 
                Style="{StaticResource DisplayTextBlockStyle}"/>
            <TextBlock 
                TextAlignment="Center"
                Text="Open an image to get started" 
                Style="{StaticResource BodyLargeStrongTextBlockStyle}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button x:Name="OpenImageFileButton" HorizontalAlignment="Stretch" Content="Open from file" Click="OpenImageFileButton_Click"/>
                <Button x:Name="SelectImageButton" HorizontalAlignment="Stretch" Content="Select from list" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
