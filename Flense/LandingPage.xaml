<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.LandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="16"
        HorizontalAlignment="Center"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="600" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Spacing="24">
            <TextBlock
                Style="{StaticResource DisplayTextBlockStyle}"
                Text="Flense"
                TextAlignment="Center" />
            <TextBlock
                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                Text="Open an image to get started"
                TextAlignment="Center" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    x:Name="OpenImageFileButton"
                    HorizontalAlignment="Stretch"
                    Click="OpenImageFileButton_Click"
                    Content="Open from file" />
                <Button
                    x:Name="SelectImageButton"
                    HorizontalAlignment="Stretch"
                    Content="Select from list"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
