import "FilesystemChangeVisibility.idl";
import "ImageLayerWrapper.idl";

namespace Flense
{
    [bindable]
    [default_interface]
    runtimeclass ImageDetailsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        ImageDetailsViewModel();

        String ImageArchivePath;
        Windows.Foundation.Collections.IObservableVector<Flense.ImageLayerWrapper> Layers { get; };
        Flense.ImageLayerWrapper SelectedLayer;

        Boolean IsLoading { get; };
        Double LoadingProgress { get; };
        String StatusMessage;
        String ErrorMessage { get; };
        String FilterQuery;
        Boolean ShowUnchanged;
        Boolean ShowAdded;
        Boolean ShowModified;
        Boolean ShowRemoved;
        String ErrorDetails { get; };

        Windows.Foundation.IAsyncAction LoadAsync();

        static FilesystemChangeVisibility BuildChangeVisibility(
            Boolean showUnchanged, Boolean showAdded, Boolean showModified, Boolean showRemoved);
    }
}
