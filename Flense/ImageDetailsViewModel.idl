import "ImageLayerWrapper.idl";

namespace Flense
{
    [bindable]
    [default_interface]
    runtimeclass ImageDetailsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        ImageDetailsViewModel();

        Windows.Storage.StorageFile ImageArchive;
        Windows.Foundation.Collections.IObservableVector<Flense.ImageLayerWrapper> Layers { get; };
        Flense.ImageLayerWrapper SelectedLayer;

        Boolean IsLoading { get; };
        Boolean IsLoaded { get; };
        Double LoadingProgress { get; };
        String StatusMessage;

        Windows.Foundation.IAsyncAction LoadAsync();
    }
}
