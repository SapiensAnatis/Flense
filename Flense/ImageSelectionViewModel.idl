import "DockerEngineImage.idl";

namespace Flense
{
    [bindable]
    [default_interface]
    runtimeclass ImageSelectionViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        ImageSelectionViewModel();
        Windows.Foundation.Collections.IObservableVector<Flense.DockerEngineImage> Images { get; };
        Windows.Foundation.IAsyncAction LoadImageList();
        Boolean IsLoading { get; };
        Boolean HasLoaded { get; };
        String SearchQuery;
    }
}
