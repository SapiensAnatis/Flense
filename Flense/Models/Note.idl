namespace Flense.Models
{
    enum NoteState
    {
        Unset = 0,
        Unsaved,
        Saved,
        Deleted
    };

    runtimeclass Note : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Note(String filename, String text, Windows.Foundation.DateTime date);

        String Text;
        String Filename{ get; };
        String DisplayDate{ get; };
        NoteState State;

        Windows.Foundation.IAsyncAction SaveAsync();
        Windows.Foundation.IAsyncAction DeleteAsync();
    }
}