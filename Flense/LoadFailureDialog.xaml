<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Flense.LoadFailureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Couldn't open this image"
    CloseButtonText="OK"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />

        <StackPanel Spacing="12" Visibility="{x:Bind HasDetails}">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Details" />
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <TextBlock
                    FontFamily="Cascadia Mono, Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Details}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
