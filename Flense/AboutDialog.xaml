<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Flense.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="About Flense"
    CloseButtonText="Close"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="24">
        <StackPanel Spacing="12">
            <TextBlock>
                <Run Text="Version:" />
                <Run Text="{x:Bind AppVersion}" />
            </TextBlock>
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/SapiensAnatis/Flense">Source code (on GitHub)</Hyperlink>
            </TextBlock>
        </StackPanel>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                Text="Third-party licenses" />
            <TextBlock
                Grid.Row="1"
                Text="Flense wouldn't have been possible to make without the help of some very useful libraries. Their respective licenses are detailed below."
                TextWrapping="Wrap" />
            <ScrollViewer
                Grid.Row="2"
                Height="320"
                Padding="0,0,14,0">
                <ItemsControl ItemsSource="{x:Bind Licenses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:License">
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Header="{x:Bind Name}">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Notice}"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="LicenseErrorText"
                Grid.Row="2"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</ContentDialog>
