namespace Flense
{
    enum FilesystemChangeKind
    {
        Unspecified = 0,
        None = 1,
        Added = 2,
        Removed = 3,
    };

    runtimeclass FilesystemTreeNode
    {
        String Name { get; };
        Boolean IsDirectory { get; };
        FilesystemChangeKind ChangeKind { get; };
        Microsoft.UI.Xaml.Media.Brush Background { get; };
        Windows.Foundation.Collections.IObservableVector<FilesystemTreeNode> Children { get; };
    }
}
