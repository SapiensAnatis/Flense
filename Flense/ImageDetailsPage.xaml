<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="FilesystemItemContentStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,3,0,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate x:Key="FilesystemItemTemplate" x:DataType="local:FilesystemTreeNode">
                <TreeViewItem VerticalContentAlignment="Stretch" ItemsSource="{x:Bind Children}">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!--  Background for first two columns  -->
                        <Border
                            Grid.ColumnSpan="2"
                            Background="{x:Bind ChangeKind, Converter={StaticResource FilesystemItemColourConverter}}"
                            CornerRadius="{ThemeResource ControlCornerRadius}" />

                        <Border
                            Grid.Column="0"
                            Padding="8,0"
                            Style="{StaticResource FilesystemItemContentStyle}">
                            <FontIcon Glyph="{x:Bind Kind, Converter={StaticResource FileKindGlyphConverter}}" />
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource FilesystemItemContentStyle}">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="0,0,16,0"
                            Style="{StaticResource FilesystemItemContentStyle}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Size, Converter={StaticResource FileSizeStringConverter}}"
                                TextAlignment="Right" />
                        </Border>
                    </Grid>
                </TreeViewItem>
            </DataTemplate>

            <local:FilesystemItemColourConverter x:Key="FilesystemItemColourConverter" />

            <local:FileKindGlyphConverter x:Key="FileKindGlyphConverter" />

            <local:FileSizeStringConverter x:Key="FileSizeStringConverter" />

        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <UserControl Name="LoadingDisplay" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid Padding="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Spacing="16">
                    <TextBlock
                        x:Name="MessageTextBlock"
                        Margin="16"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Margin="16"
                        Maximum="100"
                        Minimum="0"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </UserControl>
        <UserControl Name="ImageDetails" Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
            <Grid Padding="36,16,36,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,36"
                    Style="{ThemeResource TitleLargeTextBlockStyle}"
                    Text="Image analysis" />
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Layers" />
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLayer, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ImageLayerWrapper">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Command}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Filesystem changes" />

                            <Border
                                Grid.Row="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid CornerRadius="{ThemeResource ControlCornerRadius}" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="8,6" Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Padding="40,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Left"
                                            Text="Name" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Rectangle
                                                Grid.Column="1"
                                                Width="1"
                                                Height="20"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                HorizontalTextAlignment="Left"
                                                Text="Size" />
                                        </StackPanel>
                                    </Grid>
                                    <TreeView
                                        Grid.Row="1"
                                        CanDragItems="False"
                                        CanReorderItems="False"
                                        ItemTemplate="{StaticResource FilesystemItemTemplate}"
                                        ItemsSource="{x:Bind ViewModel.SelectedLayer.FilesystemChanges.Children, Mode=OneWay}">
                                        <TreeView.Resources>
                                            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                                        </TreeView.Resources>
                                    </TreeView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </UserControl>
    </Grid>
</Page>
