<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  DataTemplate for folders  -->
        <DataTemplate x:Key="FolderTemplate" x:DataType="local:FilesystemTreeNode">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name}"
                Background="{x:Bind Background}"
                ItemsSource="{x:Bind Children}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE8B7;" />
                    <TextBlock Margin="0,0,10,0" />
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!--  DataTemplate for files  -->
        <DataTemplate x:Key="FileTemplate" x:DataType="local:FilesystemTreeNode">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}" Background="{x:Bind Background}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE8A5;" />
                    <TextBlock Margin="0,0,10,0" />
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <local:FilesystemItemTemplateSelector
            x:Key="FilesystemItemTemplateSelector"
            FileTemplate="{StaticResource FileTemplate}"
            FolderTemplate="{StaticResource FolderTemplate}" />

    </Page.Resources>

    <Grid>
        <UserControl Name="LoadingDisplay" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid Padding="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Spacing="16">
                    <TextBlock
                        x:Name="MessageTextBlock"
                        Margin="16"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Margin="16"
                        Maximum="100"
                        Minimum="0"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </UserControl>
        <UserControl Name="ImageDetails" Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
            <Grid Padding="36,16,36,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,36"
                    Style="{ThemeResource TitleLargeTextBlockStyle}"
                    Text="Image analysis" />
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Layers" />
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLayer, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ImageLayerWrapper">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Command}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Filesystem changes" />

                            <Border
                                Grid.Row="1"
                                Padding="2,4,2,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <TreeView ItemTemplateSelector="{StaticResource FilesystemItemTemplateSelector}" ItemsSource="{x:Bind ViewModel.SelectedLayer.FilesystemChanges.Children, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </UserControl>
    </Grid>
</Page>
