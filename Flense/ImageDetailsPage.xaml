<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid Padding="36" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="1"
                Padding="200,0"
                Spacing="16">
                <TextBlock
                    Margin="16"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Margin="16"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}" />
                <Button
                    x:Name="CancelLoadingButton"
                    MinWidth="100"
                    HorizontalAlignment="Center"
                    Click="CancelLoadingButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </Grid>


        <Grid
            Padding="36,16,36,40"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Layers" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLayer, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImageLayerWrapper">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Command}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Filesystem changes" />
                        <TextBox
                            x:Name="FilesystemSearchBox"
                            Grid.Column="1"
                            PlaceholderText="Search" />
                        <Button
                            Grid.Column="2"
                            Padding="12,8"
                            VerticalAlignment="Center">
                            <FontIcon FontSize="14" Glyph="&#xE71C;" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="8">
                                        <CheckBox
                                            x:Name="UnchangedFilterItem"
                                            Content="Unchanged"
                                            IsChecked="True" />
                                        <CheckBox
                                            x:Name="AddedFilterItem"
                                            Content="Added"
                                            IsChecked="True" />
                                        <CheckBox
                                            x:Name="ModifiedFilterItem"
                                            Content="Modified"
                                            IsChecked="True" />
                                        <CheckBox
                                            x:Name="RemovedFilterItem"
                                            Content="Removed"
                                            IsChecked="True" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <local:FilesystemChangesView
                        Grid.Row="1"
                        ChangeVisibility="{x:Bind local:ImageDetailsPage.BuildChangeVisibility(UnchangedFilterItem.IsChecked, AddedFilterItem.IsChecked, ModifiedFilterItem.IsChecked, RemovedFilterItem.IsChecked), Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.SelectedLayer.FilesystemChanges.Children, Mode=OneWay}"
                        SearchQuery="{x:Bind FilesystemSearchBox.Text, Mode=OneWay}" />

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Border.Resources>
                            <Style x:Key="CodeTextBlockStyle" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </Border.Resources>
                        <StackPanel Spacing="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Command" />
                            <ScrollViewer
                                Height="75"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CodeTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedLayer.Command, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
