<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flense.ImageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flense"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="LoadingGrid"
            Padding="36"
            x:Load="{x:Bind local:BindingHelpers.AndNot(ViewModel.IsLoading, ViewModel.HasFailed), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="1"
                Padding="200,0"
                Spacing="16">
                <TextBlock
                    Margin="16"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Margin="16"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}" />
                <Button
                    x:Name="CancelLoadingButton"
                    MinWidth="100"
                    HorizontalAlignment="Center"
                    Click="CancelLoadingButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="LoadFailurePanel"
            MaxWidth="600"
            Padding="36"
            VerticalAlignment="Center"
            x:Load="{x:Bind ViewModel.HasFailed, Mode=OneWay}"
            Spacing="20">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Couldn't open this image"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Padding="8"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4"
                Visibility="{x:Bind local:BindingHelpers.VisibleIfNotEmpty(ViewModel.ErrorDetails), Mode=OneWay}">
                <TextBlock
                    FontFamily="Cascadia Mono, Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>

            <Button
                x:Name="LoadFailureBackButton"
                MinWidth="100"
                HorizontalAlignment="Center"
                Click="LoadFailureBackButton_Click"
                Content="Go back"
                Loaded="LoadFailureBackButton_Loaded" />
        </StackPanel>

        <Grid
            x:Name="ImageDetailsGrid"
            Padding="4,0,0,0"
            x:Load="{x:Bind local:BindingHelpers.Not(ViewModel.IsLoading), Mode=OneWay}"
            ColumnSpacing="4">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Layers" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLayer, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImageLayerWrapper">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Command}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8,0,0,0">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Filesystem changes" />
                        <TextBox
                            Grid.Column="1"
                            PlaceholderText="Search"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Padding="12,8"
                            VerticalAlignment="Center">
                            <FontIcon FontSize="14" Glyph="&#xE71C;" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="8">
                                        <CheckBox
                                            Content="Unchanged"
                                            IsChecked="{x:Bind ViewModel.ShowUnchanged, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Added"
                                            IsChecked="{x:Bind ViewModel.ShowAdded, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Modified"
                                            IsChecked="{x:Bind ViewModel.ShowModified, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Removed"
                                            IsChecked="{x:Bind ViewModel.ShowRemoved, Mode=TwoWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <local:FilesystemChangesView
                        Grid.Row="1"
                        ChangeVisibility="{x:Bind local:ImageDetailsViewModel.BuildChangeVisibility(ViewModel.ShowUnchanged, ViewModel.ShowAdded, ViewModel.ShowModified, ViewModel.ShowRemoved), Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.SelectedLayer.FilesystemChanges.Children, Mode=OneWay}"
                        SearchQuery="{x:Bind ViewModel.SearchQuery, Mode=OneWay}" />

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Border.Resources>
                            <Style x:Key="CodeTextBlockStyle" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </Border.Resources>
                        <StackPanel Spacing="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Command" />
                            <ScrollViewer
                                Height="75"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CodeTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedLayer.Command, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
