<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flense.ImageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flense"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <UserControl Name="LoadingDisplay" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid Padding="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Spacing="16">
                    <TextBlock x:Name="MessageTextBlock" Margin="16" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <ProgressBar Margin="16" Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </UserControl>
        <UserControl Name="ImageDetails" Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
            <NavigationView IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                            MenuItemsSource="{x:Bind ViewModel.Filenames}" PaneDisplayMode="Left" OpenPaneLength="500">
                <Frame x:Name="ContentFrame"/>
            </NavigationView>
        </UserControl>
    </Grid>
</Page>
